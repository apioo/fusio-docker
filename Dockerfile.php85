FROM php:8.5-apache
LABEL org.opencontainers.image.title="fusio"
LABEL org.opencontainers.image.description="Self-Hosted API Management for Builders — PHP 8.5 variant"

ENV FUSIO_PROJECT_KEY="42eec18ffdbffc9fda6110dcc705d6ce"
ENV FUSIO_ENV="prod"
ENV FUSIO_DEBUG="false"
ENV FUSIO_CONNECTION="pdo-mysql://fusio:61ad6c605975@localhost/fusio"
ENV FUSIO_MAILER="native://default"
ENV FUSIO_MESSENGER="doctrine://default"
ENV FUSIO_URL=""
ENV FUSIO_APPS_URL=""
ENV FUSIO_MAIL_SENDER=""
ENV FUSIO_TRUSTED_IP_HEADER=""
ENV FUSIO_TENANT_ID=""
ENV FUSIO_MARKETPLACE="off"
ENV FUSIO_WORKER_JAVA=""
ENV FUSIO_WORKER_JAVASCRIPT=""
ENV FUSIO_WORKER_PHP=""
ENV FUSIO_WORKER_PYTHON=""

ARG FUSIO_VERSION="7.2.1"
ARG FUSIO_APP_BACKEND="7.2.0"
ARG FUSIO_APP_DEVELOPER="7.2.1"
ARG FUSIO_APP_ACCOUNT="2.4.0"
ARG FUSIO_APP_REDOC="1.0.4"

ARG COMPOSER_VERSION="2.10.2"
ARG COMPOSER_SHA256="5ee7125f8a30a34d246cefdc0bc85b8a783b28f2aec968994118512350d28027"

RUN apt-get update && apt-get -y install --no-install-recommends \
    wget git unzip cron sudo supervisor default-mysql-client cmake \
    libpq-dev libxml2-dev libcurl3-dev libzip-dev libonig-dev \
    libpng-dev libmemcached-dev openssl libssl-dev libicu-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# php:8.5-apache má dom/lexbor/xml/curl/mbstring/opcache/pdo už zabudované —
# instalujeme jen chybějící extenze.
RUN docker-php-ext-install \
    pgsql mysqli pdo_mysql pdo_pgsql bcmath \
    zip intl gd soap sockets

# PECL: memcache-8.2/mongodb-2.4.1 jsou na PHP 8.5 rozbité (interní API) —
# memcache je optional cache, necháme ho vypnutý; mongodb bere latest.
RUN pecl install mongodb
RUN docker-php-ext-enable mongodb

RUN wget -O /usr/bin/composer "https://getcomposer.org/download/${COMPOSER_VERSION}/composer.phar" \
    && echo "${COMPOSER_SHA256} */usr/bin/composer" | sha256sum -c - \
    && chmod +x /usr/bin/composer

RUN mkdir /var/www/html/fusio \
    && wget -O /var/www/html/fusio/fusio.zip "https://github.com/apioo/fusio/releases/download/v${FUSIO_VERSION}/fusio.zip" \
    && cd /var/www/html/fusio && unzip fusio.zip && rm fusio.zip
COPY ./fusio /var/www/html/fusio
RUN cd /var/www/html/fusio && /usr/bin/composer install --no-dev --classmap-authoritative \
    && chmod +x /var/www/html/fusio/bin/fusio

RUN rm /etc/apache2/sites-available/*.conf /etc/apache2/sites-enabled/*.conf
COPY ./docker/apache/fusio.conf /etc/apache2/sites-available/fusio.conf
RUN a2enmod rewrite && a2ensite fusio

COPY ./docker/supervisor/fusio.conf /etc/supervisor/conf.d/fusio.conf
RUN mv "${PHP_INI_DIR}/php.ini-production" "${PHP_INI_DIR}/php.ini"
COPY ./docker/php/fusio.ini "${PHP_INI_DIR}/conf.d/fusio.ini"

RUN mkdir /var/www/html/fusio/public/apps/fusio \
    && wget -O /var/www/html/fusio/public/apps/fusio/fusio.zip "https://github.com/apioo/fusio-apps-backend/releases/download/v${FUSIO_APP_BACKEND}/fusio.zip" \
    && cd /var/www/html/fusio/public/apps/fusio && unzip fusio.zip && rm fusio.zip
RUN mkdir /var/www/html/fusio/public/apps/developer \
    && wget -O /var/www/html/fusio/public/apps/developer/developer.zip "https://github.com/apioo/fusio-apps-developer/releases/download/v${FUSIO_APP_DEVELOPER}/developer.zip" \
    && cd /var/www/html/fusio/public/apps/developer && unzip developer.zip && rm developer.zip
RUN mkdir /var/www/html/fusio/public/apps/account \
    && wget -O /var/www/html/fusio/public/apps/account/account.zip "https://github.com/apioo/fusio-apps-account/releases/download/v${FUSIO_APP_ACCOUNT}/account.zip" \
    && cd /var/www/html/fusio/public/apps/account && unzip account.zip && rm account.zip
RUN wget -O /var/www/html/fusio/public/apps/redoc.zip "https://github.com/apioo/fusio-apps-redoc/archive/refs/tags/v${FUSIO_APP_REDOC}.zip" \
    && cd /var/www/html/fusio/public/apps && unzip redoc.zip && rm redoc.zip \
    && mv fusio-apps-redoc-${FUSIO_APP_REDOC} redoc

RUN rm -f /var/www/html/fusio/public/install.php && rm -rf /tmp/pear \
    && chown -R www-data: /var/www/html/fusio

COPY ./docker/fusio/run_cron.sh /var/www/html/fusio/run_cron.sh
RUN echo "" > /etc/cron.d/fusio \
    && echo "* * * * * www-data /var/www/html/fusio/run_cron.sh cronjob" >> /etc/cron.d/fusio \
    && echo "0 0 1 * * www-data /var/www/html/fusio/run_cron.sh log_rotate" >> /etc/cron.d/fusio \
    && echo "0 0 1 * * www-data /var/www/html/fusio/run_cron.sh clean" >> /etc/cron.d/fusio \
    && chmod 0644 /etc/cron.d/fusio && chmod +x /var/www/html/fusio/run_cron.sh

COPY ./docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
